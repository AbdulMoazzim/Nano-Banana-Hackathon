# Local Trash-Net inference uses the cached pretrained checkpoint.
# OpenRouter is used for classification and optional visible-condition assessment.
# Browser access: set this to the exact deployed frontend origin (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_CONDITION_TIMEOUT_SECONDS=20
OPENROUTER_CONDITION_MAX_TOKENS=256
OPENROUTER_CLASSIFICATION_MAX_TOKENS=256

OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free

# Optional final external fallback after all OpenRouter models fail.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_CLASSIFICATION_MAX_TOKENS=256
GEMINI_CONDITION_MAX_TOKENS=256
